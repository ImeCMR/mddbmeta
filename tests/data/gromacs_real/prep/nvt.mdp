integrator = md
dt = 0.002
nsteps = 1000
nstxout-compressed = 250
nstenergy = 250
nstlog = 250
continuation = no
gen_vel = yes
gen_temp = 300
gen_seed = 11
constraints = h-bonds
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 0.9
rvdw = 0.9
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau_t = 0.1 0.1
ref_t = 300 300
pcoupl = no
pbc = xyz
