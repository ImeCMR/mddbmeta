integrator = md
dt = 0.002
nsteps = 2500
nstxout-compressed = 500
nstenergy = 250
nstlog = 250
continuation = yes
gen_vel = no
gen_temp = 300
gen_seed = 11
constraints = h-bonds
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 0.9
rvdw = 0.9
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau_t = 0.1 0.1
ref_t = 300 300
pcoupl = C-rescale
pcoupltype = isotropic
tau_p = 2.0
ref_p = 1.0
compressibility = 4.5e-5
pbc = xyz
